# 复制本文件为 .env，填入你的密钥后保存（开发服务会自动重启）。
# 不填 LLM_API_KEY 时，宠物使用内置的模拟回复（不联网）。

LLM_API_KEY=

# 默认使用 DeepSeek。换其他家时改下面三项，任何兼容 OpenAI 格式的接口都可以
# （模型名以各家控制台为准）：
#   通义千问    https://dashscope.aliyuncs.com/compatible-mode/v1
#   豆包(火山)  https://ark.cn-beijing.volces.com/api/v3
#   智谱        https://open.bigmodel.cn/api/paas/v4
#   Moonshot   https://api.moonshot.cn/v1
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 合并进请求体的额外参数（JSON）。这里关掉 DeepSeek 的思考模式：
# 宠物只说一两句话，不需要思考，关掉后回复更快也更省钱。换其他家时请删掉这一行。
LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}

# 访问口令（可选）。部署到公网时强烈建议设置：设了之后第一次聊天要输入口令，
# 不知道口令的人无法消耗你的模型额度。
ACCESS_CODE=
